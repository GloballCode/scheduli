rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================
    // HELPER FUNCTIONS
    // ==========================

    function isMemberOfWorkspace(wsId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
    }

    function isOwnerOfWorkspace(wsId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/workspaces/$(wsId)).data.ownerId == request.auth.uid;
    }

    // ==========================
    // USERS
    // ==========================

    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ==========================
    // WORKSPACES
    // ==========================

    match /workspaces/{wsId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null;

      allow update, delete: if isOwnerOfWorkspace(wsId);
    }

    // ==========================
    // MEMBERS
    // ==========================

    match /workspaces/{wsId}/members/{uid} {

      allow read: if isMemberOfWorkspace(wsId);

      allow create, update, delete: if isOwnerOfWorkspace(wsId);
    }

    // ==========================
    // APPOINTMENTS
    // ==========================

    match /appointments/{apptId} {

      // Ler
      allow read: if request.auth != null
        && resource.data.workspaceId != null
        && isMemberOfWorkspace(resource.data.workspaceId);

      // Criar
      allow create: if request.auth != null
        && request.resource.data.workspaceId != null
        && isMemberOfWorkspace(request.resource.data.workspaceId)
        && request.resource.data.professionalUid == request.auth.uid;

      // Atualizar
      allow update: if request.auth != null
        && resource.data.workspaceId != null
        && (
          resource.data.professionalUid == request.auth.uid
          || isOwnerOfWorkspace(resource.data.workspaceId)
        );

      // Deletar
      allow delete: if request.auth != null
        && resource.data.workspaceId != null
        && (
          resource.data.professionalUid == request.auth.uid
          || isOwnerOfWorkspace(resource.data.workspaceId)
        );
    }
  }
}